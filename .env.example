# ───────────────────────────────────────────────────────────────
#  SmartMoney Sentinel — environment template
#
#  Copy this file to your secrets location and fill in real values:
#      cp .env.example ~/.config/guga/.env
#      chmod 600 ~/.config/guga/.env      # readable only by you
#
#  NEVER commit the real .env. It is gitignored for a reason.
# ───────────────────────────────────────────────────────────────

# Anthropic API key — used for daily narration (Haiku) and the
# post-mortem why-engine. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram bot — create a bot via @BotFather to get the token,
# then message your bot and read the chat_id from getUpdates.
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=000000000
